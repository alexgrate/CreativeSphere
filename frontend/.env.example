# Copy to .env. Vite bakes these into the built JS at build time, so they are
# public — never put a secret behind a VITE_ prefix.

# The API's base URL, no trailing slash.
# Leave unset if the API is served from the same domain as the site (requests
# then go to /api/... on the current origin).
# Set it when the API lives on its own domain, e.g. https://api.your-domain.com
VITE_API_URL=

<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the built site. Lives in public/ so every `npm run build`
  copies it into dist/ automatically.

  Point one IIS site at the dist folder. It serves the React app and hands
  /api, /admin, /static and /media to Django running under waitress on
  127.0.0.1:8001, so the whole site is one origin and needs no CORS.

  Requires two free IIS modules, neither installed by default:
    - URL Rewrite 2.1
    - Application Request Routing 3.0  (then Server -> ARR Cache -> Proxy ->
      tick "Enable proxy", or the rewrite rules below return 404)
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Everything over plain HTTP goes to HTTPS. This has to live in IIS:
             Django's SECURE_SSL_REDIRECT only sees requests that reach Django,
             and the React pages are static files IIS serves itself.

             The .well-known exclusion keeps ACME certificate validation working
             over port 80, which is how renewals prove the domain. -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Anything Django owns goes to waitress. Keep this first. -->
        <!-- The port here MUST match BACKEND_PORT in backend\.env. 8000 is
             Django's default, so on a machine already running another Django
             app you will need a different one in both places. -->
        <rule name="Proxy to Django" stopProcessing="true">
          <match url="^(api|admin|static|media)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:0}" />
          <serverVariables>
            <!-- Tells Django the original request was HTTPS even though the
                 proxied hop is plain HTTP. Needs BEHIND_PROXY=True in the
                 backend .env, and this variable added under
                 URL Rewrite -> View Server Variables. Without it, Django's
                 HTTPS redirect loops forever. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!-- Everything else is the single-page app. Without this, refreshing
             /work/vfd or opening a shared link returns a 404, because no such
             folder exists on disk — the router resolves it in the browser.

             Only IsFile is checked, deliberately. An IsDirectory condition
             looks sensible but breaks any route whose name matches a real
             folder under public/ — /work and /about both do, and each returned
             403.14 because IIS fell through to directory listing. Real files
             are still served, because IsFile catches them first. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- IIS returns 404 for extensions it does not recognise. Every image on
           this site is .webp and the showreel is .webm, so without these the
           site loads with no imagery at all. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/json" enabled="true" />
      </dynamicTypes>
    </httpCompression>

  </system.webServer>

  <!-- Vite fingerprints everything in /assets, so those files can be cached
       forever: a change produces a new filename. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- index.html must never be cached, or visitors keep loading an old page
       that points at asset filenames which no longer exist. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>

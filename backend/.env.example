# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Django's own audit of these: `manage.py check --deploy`

# ---- Core -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Must be False in production. Leaving it True exposes source and settings.
DEBUG=False
# Comma separated. The domains Django will answer requests for. IIS proxies to
# 127.0.0.1, so include that too.
ALLOWED_HOSTS=dcreativesphere.com,www.dcreativesphere.com,127.0.0.1
# Leave EMPTY when the site and API share a domain, which they do on the VM —
# the browser makes no cross-origin request, so there is nothing to allow.
CORS_ALLOWED_ORIGINS=
# Comma separated, with scheme. Required or admin login over HTTPS is rejected.
CSRF_TRUSTED_ORIGINS=https://dcreativesphere.com,https://www.dcreativesphere.com

# ---- Database ---------------------------------------------------------------
# Omit entirely to stay on the local sqlite file.
# Postgres needs: pip install "psycopg[binary]"
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- Contact form (Microsoft Graph) -----------------------------------------
# From the Azure app registration. The app needs Mail.Send granted on the sender.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox enquiries are sent *from*.
MS_GRAPH_SENDER=robot@your-domain.com
# The mailbox enquiries are delivered *to*.
CONTACT_RECIPIENT=studio@your-domain.com

# ---- Regional ---------------------------------------------------------------
# Only affects how times read in the admin; storage is always UTC.
TIME_ZONE=Africa/Lagos

# ---- HTTPS ------------------------------------------------------------------
# These default to on whenever DEBUG is False, so normally leave them alone.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# True on the VM: IIS terminates TLS and proxies plain HTTP to waitress.
# Without it, SECURE_SSL_REDIRECT loops forever behind the proxy.
BEHIND_PROXY=True

# Django serves uploaded images itself. Fine for this traffic. Set False only
# once IIS has a /media virtual directory pointing at backend\media.
SERVE_MEDIA=True

# ---- Shared VM --------------------------------------------------------------
# The localhost port waitress listens on. 8000 is Django's default, so another
# app on the same machine may already hold it — run deploy\preflight.ps1 to see.
# If you change it, change the proxy line in frontend/public/web.config to match.
BACKEND_PORT=8000

# HSTS: browsers refuse plain HTTP for this domain for this many seconds, and it
# cannot be shortened once cached. Turn on only after HTTPS is confirmed working
# on every subdomain. 31536000 is one year.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
